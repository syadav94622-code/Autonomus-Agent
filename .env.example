# --- LLM (official provider) ---
LLM_PROVIDER=anthropic            # anthropic | groq | openai | google | xai
ANTHROPIC_API_KEY=your_key_here   # or GROQ_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY / XAI_API_KEY
# OPERATOR_MODEL=claude-sonnet-5-5   # defaults: anthropic=claude-sonnet-5-5, groq=openai/gpt-oss-120b; REQUIRED for the rest
# OPERATOR_REASONING_EFFORT=low      # groq/openai reasoning models: low = much faster tool turns (low|medium|high)
# OPERATOR_TEMPERATURE=            # leave unset: newer models reject non-default temperature

# --- Logging ---
LOG_LEVEL=INFO                    # DEBUG = full prompts, responses and tool outputs on the console
                                  # (runs/<id>/operator.log always has the full DEBUG trace)

# --- Sandbox ---
SANDBOX_URL=http://127.0.0.1:5001
HEADLESS=1
